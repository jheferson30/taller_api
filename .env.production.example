# ============================================================
# COPIA ESTE ARCHIVO COMO .env.production Y LLENA LOS VALORES
# ============================================================

# Base de datos
DB_PASSWORD=pon_una_contrasena_segura_aqui

DATABASE_URL=postgresql+psycopg2://postgres:pon_una_contrasena_segura_aqui@db:5432/taller_db?client_encoding=utf8

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CAMBIAR_genera_un_secreto_seguro_de_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Contraseña admin (app móvil)
ADMIN_PASSWORD=cambia_esta_contrasena
PDF_PASSWORD=cambia_esta_contrasena

# CSRF — genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET_KEY=CAMBIAR_genera_un_secreto_seguro

# Entorno
ENVIRONMENT=production

# HTTPS (solo habilitar cuando tengas certificados SSL configurados)
# Deja en false hasta que configures Let's Encrypt o tus certificados
FORCE_HTTPS=false

# IP pública de la VM de Azure
PUBLIC_IP=68.155.145.217

# CORS — dominio o IP pública
ALLOWED_ORIGINS=http://68.155.145.217
ALLOWED_HOSTS=68.155.145.217

# Contraseña del usuario admin inicial (se crea al primer arranque)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@taller.local

# Seguridad de contraseñas
PASSWORD_HASHER=bcrypt
BCRYPT_COST_FACTOR=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true

# Email SMTP (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Azure Key Vault (opcional)
AZURE_KEY_VAULT_URL=
