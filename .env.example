# Copia este archivo como .env y ajusta los valores

# Contrasena para autenticar operaciones del sistema
ADMIN_PASSWORD=cambia_esta_contrasena

# Contrasena para generar PDFs (puede ser la misma que ADMIN_PASSWORD)
PDF_PASSWORD=cambia_esta_contrasena

# Conexion a PostgreSQL
# Formato: postgresql+psycopg2://usuario:contrasena@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/taller_db?client_encoding=utf8
