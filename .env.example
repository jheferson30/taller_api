# Copia este archivo como .env y ajusta los valores

# ============================================================================
# AUTENTICACIÓN Y SEGURIDAD JWT
# ============================================================================

# Clave secreta para firmar tokens JWT (DEBE ser única y segura en producción)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CAMBIAR_EN_PRODUCCION_usar_secreto_seguro_de_al_menos_32_caracteres

# Algoritmo de firma JWT (recomendado: HS256)
JWT_ALGORITHM=HS256

# Tiempo de expiración del access token en minutos (default: 15)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Tiempo de expiración del refresh token en días (default: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CONTRASEÑAS Y HASHING
# ============================================================================

# Algoritmo de hashing de contraseñas (bcrypt recomendado)
PASSWORD_HASHER=bcrypt

# Factor de costo de bcrypt (4-31, recomendado: 12 para producción, 4 para tests)
BCRYPT_COST_FACTOR=12

# Requisitos de complejidad de contraseñas
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true

# ============================================================================
# RATE LIMITING
# ============================================================================

# Límite de requests de autenticación por minuto por IP
RATE_LIMIT_AUTH_PER_MINUTE=5

# Límite de requests de creación por minuto por usuario autenticado
RATE_LIMIT_CREATE_PER_MINUTE=30

# Límite de requests de lectura por minuto por usuario autenticado
RATE_LIMIT_READ_PER_MINUTE=100

# IPs excluidas de rate limiting (separadas por comas)
RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1

# ============================================================================
# SEGURIDAD Y DETECCIÓN
# ============================================================================

# Entorno de ejecución (development o production)
ENVIRONMENT=development

# Máximo de intentos de login fallidos antes de alerta
MAX_LOGIN_ATTEMPTS=5

# Ventana de tiempo para contar intentos de login (en minutos)
LOGIN_ATTEMPT_WINDOW_MINUTES=10

# ============================================================================
# RECUPERACIÓN DE CONTRASEÑA
# ============================================================================

# Tiempo de expiración del token de reset de contraseña (en horas)
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Máximo de solicitudes de reset por hora por email
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3

# ============================================================================
# SESIONES Y AUDITORÍA
# ============================================================================

# Tiempo de inactividad antes de cerrar sesión (en minutos)
SESSION_TIMEOUT_MINUTES=30

# Días de retención de logs de auditoría (0 = infinito)
AUDIT_LOG_RETENTION_DAYS=90

# ============================================================================
# MODO LEGACY (TRANSICIÓN)
# ============================================================================

# Habilitar autenticación legacy SHA256 durante período de transición
ENABLE_LEGACY_AUTH=true

# ============================================================================
# EMAIL (SMTP)
# ============================================================================

# Configuración SMTP para envío de emails (recuperación de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM=noreply@taller.com

# ============================================================================
# BASE DE DATOS
# ============================================================================

# Conexión a PostgreSQL
# Formato: postgresql+psycopg2://usuario:contrasena@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/taller_db?client_encoding=utf8

# ============================================================================
# AZURE KEY VAULT (GESTIÓN DE SECRETOS)
# ============================================================================

# URL del Azure Key Vault para gestión segura de secretos en producción
# Formato: https://<vault-name>.vault.azure.net/
# Si no se configura, el sistema usará variables de entorno como fallback
AZURE_KEY_VAULT_URL=

# ============================================================================
# CONTRASEÑAS LEGACY (COMPATIBILIDAD)
# ============================================================================

# Contraseña para autenticar operaciones del sistema (legacy)
ADMIN_PASSWORD=cambia_esta_contrasena

# Contraseña para generar PDFs (puede ser la misma que ADMIN_PASSWORD)
PDF_PASSWORD=cambia_esta_contrasena

# ============================================================================
# CORS Y ORÍGENES PERMITIDOS
# ============================================================================

# Orígenes permitidos para CORS (separados por coma)
# En producción, especificar dominios exactos (REQUERIDO)
ALLOWED_ORIGINS=https://taller.com,https://app.taller.com

# IP pública del servidor (para QR de conexión app móvil en cloud/VPS)
# Si no se configura, se usa la IP de la interfaz de red (funciona en red local)
PUBLIC_IP=

# Entorno de ejecución (development o production)
# En producción, ALLOWED_ORIGINS debe estar configurado con orígenes específicos
ENVIRONMENT=production

# Hosts confiables para TrustedHostMiddleware (separados por coma)
# Usar wildcards para subdominios: *.taller.com
ALLOWED_HOSTS=taller.com,*.taller.com

# ============================================================================
# PROTECCIÓN CSRF
# ============================================================================

# Clave secreta para firmar tokens CSRF (DEBE ser única y segura en producción)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET_KEY=your-secret-key-here-change-in-production

# ============================================================================
# CACHÉ REDIS
# ============================================================================

# URL de conexión a Redis para caché
# Formato: redis://host:puerto
REDIS_URL=redis://localhost:6379
