# Configuración para Docker (desarrollo)

# Base de datos (apunta al contenedor Docker)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/taller_db?client_encoding=utf8

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
PASSWORD_HASHER=bcrypt
BCRYPT_COST_FACTOR=12

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_CREATE_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=100
RATE_LIMIT_WHITELIST_IPS=127.0.0.1,::1

# Seguridad
ENVIRONMENT=development
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=10

# Sesiones
SESSION_TIMEOUT_MINUTES=30
AUDIT_LOG_RETENTION_DAYS=90

# Legacy
ENABLE_LEGACY_AUTH=true

# SMTP (opcional para desarrollo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_password
SMTP_FROM=noreply@taller.com

# Contraseñas legacy
ADMIN_PASSWORD=admin123
PDF_PASSWORD=admin123

# CORS (incluye localhost y 127.0.0.1)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF
CSRF_SECRET_KEY=dev-csrf-secret-key-change-in-production

# Redis (apunta al contenedor Docker)
REDIS_URL=redis://redis:6379/0

# Azure Key Vault (opcional)
AZURE_KEY_VAULT_URL=
